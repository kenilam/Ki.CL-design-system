{
  "name": "ki-cl-design-system",
  "version": "0.1.0",
  "description": "Ki.CL design system - components, styles and icons as a Module Federation remote",
  "type": "module",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "Design",
    "Server"
  ],
  "scripts": {
    "build": "yarn workspace @ki-cl/design run build",
    "development": "yarn workspace @ki-cl/design run dev",
    "production": "yarn build && NODE_ENV=production tsx Server/index.ts",
    "start": "yarn run development",
    "typecheck": "yarn workspace @ki-cl/design run typecheck",
    "lint": "oxlint",
    "lint:stylelint": "stylelint 'Design/src/**/*.{css,scss}'"
  },
  "author": "Keni Lam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenilam/Ki.CL-design-system.git"
  },
  "devDependencies": {
    "oxlint": "^1.76.0",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-sass-guidelines": "13.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "stylelint-prettier": "5.0.3",
    "stylelint-scss": "7.3.0",
    "tsx": "^4.23.1"
  }
}
